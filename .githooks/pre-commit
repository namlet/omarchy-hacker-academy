#!/bin/sh
# Block direct commits to main and develop; work happens on feature branches merged by PR.
branch=$(git symbolic-ref --short HEAD 2>/dev/null)
case "$branch" in
  main|develop)
    echo "Direct commits to '$branch' are blocked. Create a work branch off develop:" >&2
    echo "  git switch -c feature/<name> develop" >&2
    exit 1
    ;;
esac
